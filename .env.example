# Copie para apps/web/.env.local (local) ou cadastre na Vercel (produção).
# Só NOMES aqui — nunca valores reais.

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Cadastro restrito a estes e-mails (separados por vírgula). Vazio = aberto.
ALLOWED_EMAILS=

# Worker (Render) — o app web só conhece a URL e o token compartilhado
WORKER_URL=
WORKER_TOKEN=

# ---------- só no Render (worker), nunca na Vercel ----------
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
# WORKER_TOKEN=            (o mesmo valor da Vercel)
# Fase 3 · Shopee Affiliate Open API
# SHOPEE_APP_ID=
# SHOPEE_APP_SECRET=
# SHOPEE_DEFAULT_STORE_SLUG=   (loja para conversões sem subId reconhecido)
# SHOPEE_CONVERSIONS_DAYS=30   SHOPEE_CONVERSIONS_INTERVAL_MIN=120
# Fase 4 · Telegram Bot API
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_INTERVAL_SEC=60  TELEGRAM_MAX_DELAY_MIN=180  TELEGRAM_MAX_ATTEMPTS=3
